{
  "name": "webgl2-phong-app",
  "version": "1.0.0",
  "description": "WebGL2 application with Phong shading",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run test:assets && NODE_ENV=production node esbuild.config.js",
    "dev": "node esbuild.config.js serve",
    "start": "node dist/server.js",
    "dev:server": "ts-node src/server.ts",
    "test:assets": "ts-node scripts/test-obj-parser.ts"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "esbuild": "^0.25.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
